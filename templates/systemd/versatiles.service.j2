[Unit]
Description=VersaTiles ({{ versatiles_identifier }})
{% for service in versatiles_systemd_required_services_list %}
Requires={{ service }}
After={{ service }}
{% endfor %}
{% for service in versatiles_systemd_wanted_services_list %}
Wants={{ service }}
{% endfor %}
DefaultDependencies=no

[Service]
Type=simple
Environment="HOME={{ devture_systemd_docker_base_systemd_unit_home_path }}"
ExecStartPre={{ devture_systemd_docker_base_host_command_sh }} -c '{{ versatiles_container_cleanup_command | trim | replace("\n", " ") }}'

ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} create \
      --rm \
      --name={{ versatiles_identifier }} \
      --log-driver=none \
      --user={{ versatiles_uid }}:{{ versatiles_gid }} \
      --cap-drop=ALL \
      --read-only \
      --network={{ versatiles_container_network }} \
      {% if versatiles_container_http_host_bind_port %}
      -p {{ versatiles_container_http_host_bind_port }}:{{ versatiles_container_http_port }} \
      {% endif %}
      --env-file={{ versatiles_base_path }}/env \
      --label-file={{ versatiles_base_path }}/labels \
      --mount type=bind,src={{ versatiles_data_path }},dst=/data \
      {% for volume in versatiles_container_additional_volumes %}
      --mount type={{ volume.type | default('bind' if '/' in volume.src else 'volume') }},src={{ volume.src }},dst={{ volume.dst }}{{ (',' + volume.options) if volume.options | default('') else '' }} \
      {% endfor %}
      {% for arg in versatiles_container_extra_arguments %}
      {{ arg }} \
      {% endfor %}
      {{ versatiles_container_image }} /data/osm.versatiles

{% for network in versatiles_container_additional_networks %}
ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} network connect {{ network }} {{ versatiles_identifier }}
{% endfor %}

ExecStart={{ devture_systemd_docker_base_host_command_docker }} start --attach {{ versatiles_identifier }}

ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} stop -t {{ devture_systemd_docker_base_container_stop_grace_time_seconds }} {{ versatiles_identifier }} 2>/dev/null || true'
ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} rm {{ versatiles_identifier }} 2>/dev/null || true'

Restart=always
RestartSec=30
SyslogIdentifier={{ versatiles_identifier }}

[Install]
WantedBy=multi-user.target
